const (
	rpcUrl       = "http://127.0.0.1:8545"
	deployerKey  = "ac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80"
	managerKey   = "59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d"
	submitterKey = "5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a"
)

var (
	client                   *ethclient.Client
	contract                 *processorendpoint.ProcessorEndpoint = processorendpoint.NewProcessorEndpoint()
	chainID                  *big.Int
	processorContractAddress ethCommon.Address
	keyRegistryAddress       ethCommon.Address
	deployer                 *bind.TransactOpts
	submitter                *bind.TransactOpts
	manager                  *bind.TransactOpts
	managerPrivateKey        *ecdsa.PrivateKey
)

func TestMain(m *testing.M) {
	fmt.Println("Running TestMain...")

	client, err := ethclient.Dial(rpcUrl)
	if err != nil {
		panic(fmt.Errorf("call returned error: %v", err))
	}

	// Retrieve the current chain ID
	chainID, err = client.ChainID(context.Background())
	if err != nil {
		panic(fmt.Errorf("Failed to retrieve chain ID: %v", err))
	}

	managerPrivateKey, err = crypto.HexToECDSA(managerKey)
	if err != nil {
		panic(fmt.Errorf("call returned error: %v", err))
	}
	manager = bind.NewKeyedTransactor(managerPrivateKey, chainID)

	deployerPrivateKey, err := crypto.HexToECDSA(deployerKey)
	if err != nil {
		panic(fmt.Errorf("call returned error: %v", err))
	}

	deployer = bind.NewKeyedTransactor(deployerPrivateKey, chainID)

	submitterPrivateKey, err := crypto.HexToECDSA(submitterKey)
	if err != nil {
		panic(fmt.Errorf("call returned error: %v", err))
	}
	submitter = bind.NewKeyedTransactor(submitterPrivateKey, chainID)

	processorContractAddress, keyRegistryAddress = SetupContracts(client, deployer, manager.From)

	code := m.Run()

	os.Exit(code)
}

func TestConnect(t *testing.T) {

	client, err := ethclient.Dial(rpcUrl)
	require.NoError(t, err)
	instance := contract.Instance(client, processorContractAddress)

	blockchainClient := blockchain.NewBlockChainClient(processorContractAddress, keyRegistryAddress, rpcUrl, managerPrivateKey)

	//Test that no method can be called before Connect
	_, err = blockchainClient.GetPendingRequests(context.Background())
	require.Error(t, err, "GetPendingRequests should fail before Connect")

	err = blockchainClient.Connect(context.Background())
	require.NoError(t, err)

	//Double connect, should fail
	err = blockchainClient.Connect(context.Background())
	require.Error(t, err, "Connect cannot be called twice without disconnecting first")

	res, err := blockchainClient.GetPendingRequests(context.Background())

	require.NoError(t, err)
	require.Equal(t, 0, len(res), "There should be zero pending request")

	//*****************************************************
	// submit request

	// send a transaction which calls the store function
	tx, err := bind.Transact(instance, submitter, contract.PackSubmitRequest(defaultProtocolVersion, big.NewInt(1), uint8(1), ethCommon.FromHex("0x00"), big.NewInt(0)))
	if err != nil {
		panic(fmt.Errorf("failed to submit transaction: %v", err))
	}

	// call Commit to make the simulated backend mine a block
	// wait for transaction inclusion
	_, err = bind.WaitMined(context.Background(), client, tx.Hash())
	require.NoError(t, err, "error waiting for tx inclusion")

	res, err = blockchainClient.GetPendingRequests(context.Background())

	require.NoError(t, err)
	require.Equal(t, 1, len(res), "There should be one pending request")
	request := res[0]
	require.Equal(t, "0", request.ProtocolVersion, "Protocol version should match")
	require.Equal(t, "1", request.ApplicationID, "Application ID should match")
	require.Equal(t, common.Process, request.RequestType, "Request type should match")
	require.Equal(t, ethCommon.FromHex("0x00"), request.Payload, "Payload should match")
	require.Greater(t, request.Timestamp, int64(0), "Timestamp should match")
	require.Equal(t, submitter.From.String(), request.Sender, "Sender should match")

}

func TestSubmitStateUpdate(t *testing.T) {

	client, err := ethclient.Dial(rpcUrl)
	require.NoError(t, err)
	instance := contract.Instance(client, processorContractAddress)

	blockchainClient := blockchain.NewBlockChainClient(processorContractAddress, keyRegistryAddress, rpcUrl, managerPrivateKey)

	blockchainClient.Connect(context.Background())
	require.NoError(t, err)

	//*****************************************************
	// submit request
	submitter.Value = big.NewInt(1000000000000000000) // 1 ETH

	tx, err := bind.Transact(instance, submitter, contract.PackSubmitRequest(defaultProtocolVersion, applicationId, uint8(1), ethCommon.FromHex("0x00"), big.NewInt(0)))
	require.NoError(t, err)

	// wait for transaction inclusion
	_, err = bind.WaitMined(context.Background(), client, tx.Hash())
	require.NoError(t, err, "error waiting for tx inclusion")

	res, err := blockchainClient.GetPendingRequests(context.Background())
	require.NoError(t, err)

	events := [1]common.Event{{ApplicationID: res[0].ApplicationID, EncryptedData: []byte{0x04, 0x05, 0x06}}}
	withdrawals := []common.Withdrawal{
		{DestinationAddress: "0x1234567890123456789012345678901234567890", Amount: "100000000000000"},
	}

	oldStateRoot, err := bind.Call(instance,
		&bind.CallOpts{Pending: false},
		contract.PackStateRoot(),
		contract.UnpackStateRoot)
	require.NoError(t, err)

	signature := [65]byte{}
	payload := &common.UpdatePayload{
		ApplicationID: "1",
		//ApplicationID: res[0].ApplicationID,
		RequestID:     res[0].RequestID,
		PrevStateRoot: oldStateRoot,
		NewStateRoot:  []byte{0x04, 0x05, 0x06},
		Events:        events[:],
		Withdrawals:   withdrawals,
		Signature:     signature[:],
	}
	err = blockchainClient.SubmitStateUpdate(context.Background(), payload)

	require.NoError(t, err)

	res, err = blockchainClient.GetPendingRequests(context.Background())
	require.NoError(t, err)
	require.Equal(t, 0, len(res), "There should be 0 pending request")
}

func TestClose(t *testing.T) {

	client, err := ethclient.Dial(rpcUrl)
	require.NoError(t, err)
	instance := contract.Instance(client, processorContractAddress)

	blockchainClient := blockchain.NewBlockChainClient(processorContractAddress, keyRegistryAddress, rpcUrl, managerPrivateKey)

	// close can be called before Connect
	err = blockchainClient.Close()
	require.NoError(t, err)

	err = blockchainClient.Connect(context.Background())
	require.NoError(t, err)

	err = blockchainClient.Close()
	require.NoError(t, err)

	//Test that no method can be called after Close
	_, err = blockchainClient.GetPendingRequests(context.Background())
	require.Error(t, err, "GetPendingRequests should fail before Connect")

	//Reconnect, should work
	err = blockchainClient.Connect(context.Background())
	require.NoError(t, err)

	res, err := blockchainClient.GetPendingRequests(context.Background())

	require.NoError(t, err)
	require.Equal(t, 0, len(res), "There should be zero pending request")

	//*****************************************************
	// submit request

	// send a transaction which calls the store function
	tx, err := bind.Transact(instance, submitter, contract.PackSubmitRequest(defaultProtocolVersion, big.NewInt(1), uint8(1), ethCommon.FromHex("0x00"), big.NewInt(0)))
	if err != nil {
		panic(fmt.Errorf("failed to submit transaction: %v", err))
	}

	// call Commit to make the simulated backend mine a block
	// wait for transaction inclusion
	_, err = bind.WaitMined(context.Background(), client, tx.Hash())
	require.NoError(t, err, "error waiting for tx inclusion")

	fmt.Println("transaction invoking store method was successfully included")

	res, err = blockchainClient.GetPendingRequests(context.Background())

	require.NoError(t, err)
	require.Equal(t, 1, len(res), "There should be one pending request")
	request := res[0]
	require.Equal(t, "0", request.ProtocolVersion, "Protocol version should match")
	require.Equal(t, "1", request.ApplicationID, "Application ID should match")
	require.Equal(t, common.Process, request.RequestType, "Request type should match")
	require.Equal(t, ethCommon.FromHex("0x00"), request.Payload, "Payload should match")
	require.Greater(t, request.Timestamp, int64(0), "Timestamp should match")
	require.Equal(t, submitter.From.String(), request.Sender, "Sender should match")

}

func SetupContracts(node *ethclient.Client, deployerSigner *bind.TransactOpts, processorAddress ethCommon.Address) (processorContractAddress ethCommon.Address, keyRegistryAddress ethCommon.Address) {

	// use the default deployer: it simply creates, signs and submits the deployment transactions
	deployer := bind.DefaultDeployer(deployerSigner, node)

	// create and submit the contract deployment
	teeDeployParams := bind.DeploymentParams{
		Contracts: []*bind.MetaData{&tee.MockTeeAuthenticatorMetaData},
	}

	deployRes, err := bind.LinkAndDeploy(&teeDeployParams, deployer)
	if err != nil {
		panic(fmt.Errorf("error submitting contract: %v", err))
	}

	teeAddress, tx := deployRes.Addresses[tee.MockTeeAuthenticatorMetaData.ID], deployRes.Txs[tee.MockTeeAuthenticatorMetaData.ID]

	// wait for the pending contract to be deployed on-chain
	if _, err := bind.WaitDeployed(context.Background(), node, tx.Hash()); err != nil {
		panic(fmt.Errorf("failed waiting for contract deployment: %v", err))
	}
	fmt.Printf("Tee contract deployed at address 0x%x\n", teeAddress)

	authorityContract := *authority.NewAuthorityRegistry()

	constructorInput := authorityContract.PackConstructor(deployerSigner.From)
	deployParams := bind.DeploymentParams{
		Contracts: []*bind.MetaData{&authority.AuthorityRegistryMetaData},
		Inputs:    map[string][]byte{authority.AuthorityRegistryMetaData.ID: constructorInput},
	}

	deployRes, err = bind.LinkAndDeploy(&deployParams, deployer)
	if err != nil {
		panic(fmt.Errorf("error submitting authority registry contract: %v", err))
	}

	authorityAddress, tx := deployRes.Addresses[authority.AuthorityRegistryMetaData.ID], deployRes.Txs[authority.AuthorityRegistryMetaData.ID]

	// wait for the pending contract to be deployed on-chain
	if _, err := bind.WaitDeployed(context.Background(), node, tx.Hash()); err != nil {
		panic(fmt.Errorf("failed waiting for contract deployment: %v", err))
	}
	fmt.Printf("Authority Registry contract deployed at address 0x%x\n", teeAddress)

	contract := *processorendpoint.NewProcessorEndpoint()

	constructorInput = contract.PackConstructor(teeAddress, authorityAddress, processorAddress)
	// set up params to deploy an instance of the ProcessorEndpoint contract
	deployParams = bind.DeploymentParams{
		Contracts: []*bind.MetaData{&processorendpoint.ProcessorEndpointMetaData},
		Inputs:    map[string][]byte{processorendpoint.ProcessorEndpointMetaData.ID: constructorInput},
	}

	// create and submit the contract deployment
	deployRes, err = bind.LinkAndDeploy(&deployParams, deployer)
	if err != nil {
		panic(fmt.Errorf("error submitting contract: %v", err))
	}

	processorContractAddress, tx = deployRes.Addresses[processorendpoint.ProcessorEndpointMetaData.ID], deployRes.Txs[processorendpoint.ProcessorEndpointMetaData.ID]

	deployParams = bind.DeploymentParams{
		Contracts: []*bind.MetaData{&keyregistry.KeyRegistryMetaData},
	}

	// create and submit the contract deployment
	deployRes, err = bind.LinkAndDeploy(&deployParams, deployer)
	if err != nil {
		panic(fmt.Errorf("error submitting contract: %v", err))
	}

	keyRegistryAddress, tx = deployRes.Addresses[keyregistry.KeyRegistryMetaData.ID], deployRes.Txs[keyregistry.KeyRegistryMetaData.ID]

	// wait for the pending contract to be deployed on-chain
	if _, err := bind.WaitDeployed(context.Background(), node, tx.Hash()); err != nil {
		panic(fmt.Errorf("failed waiting for contract deployment: %v", err))
	}
	fmt.Printf("Processor contract deployed at address 0x%x\n", processorContractAddress)

	return

}

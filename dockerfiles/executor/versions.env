# =============================================================================
# Pinned build inputs for the reproducible Executor EIF (Task 7 / R5).
# Base: Amazon Linux 2023.
#
# Every value here is part of the reproducibility contract: change one and
# PCR0/1/2 change. Resolve each __TODO__ once per toolchain bump; build-eif.sh
# refuses to run (and the CI reproducibility check stays informational) while
# any placeholder remains.
#
# AL2023 strategy: pin the whole repo SNAPSHOT via AL_RELEASEVER rather than
# per-package version strings. AL2023's versioned repositories keep that
# snapshot's RPMs fetchable long-term, which is what makes rebuilds during the
# timelock window (and well beyond) reproducible.
# =============================================================================

# Base image, shared by builder + runtime so the cgo (wasmtime-go) binary's
# glibc matches the runtime glibc exactly. Pin is the multi-arch INDEX digest
# (the build platform selects the matching manifest).
#   resolve: docker buildx imagetools inspect amazonlinux:2023 \
#              --format '{{.Manifest.Digest}}'
BASE_IMAGE="amazonlinux:2023@sha256:32f61af6a24e178e8142fb7b0079f4af3a5cda6816cd53d2c611a921ef029ca0"

# AL2023 repo snapshot. Freezes every dnf-installed package (gcc/binutils, the
# runtime RPMs, and nitro-cli + its blobs) to one immutable version set.
#   resolve (inside the pinned BASE_IMAGE): read PRETTY_NAME from /etc/os-release
#     -> "Amazon Linux <snapshot>". Snapshots are listed at
#     https://cdn.amazonlinux.com/al2023/core/mirrors/
AL_RELEASEVER="2023.12.20260611"

# Go toolchain. GO_SHA256 = sha256 of go${GO_VERSION}.linux-amd64.tar.gz.
# MUST match go.mod's `toolchain` directive (go1.24.3): the Dockerfile sets
# GOTOOLCHAIN=local so Go uses exactly this installed toolchain and never
# silently downloads a different one at build time (which would break
# reproducibility and self-containment). If go.mod's toolchain is bumped, bump
# GO_VERSION here to match, or the build fails loudly.
#   resolve: https://go.dev/dl/?mode=json&include=all -> the file's "sha256".
#            Do NOT guess it - a wrong value fails the in-Dockerfile
#            `sha256sum -c` and aborts the build.
GO_VERSION="1.24.3"
GO_SHA256="3333f6ea53afa971e9078895eaa4ac7204a8c6b5c68c10e6bc9a33e8e391bdd8"

# Package name lists (versions are fixed by AL_RELEASEVER, so no EVRs here).
# No NSM package: it does not exist on AL2023, and the executor's NSM path is
# pure-Go ioctl (github.com/hf/nsm) - the device is provided by the nitro-cli
# enclave kernel, needing no userspace RPM. ca-certificates is for outbound KMS
# TLS; shadow-utils for the service user.
BUILDER_PACKAGES="gcc tar gzip git"
RUNTIME_PACKAGES="ca-certificates shadow-utils"

# nitro-cli toolbox. Its version (hence the EIF blobs) is fixed by AL_RELEASEVER
# on the same base family; build-eif.sh records the resolved RPM version in
# build-info.json.
NITRO_CLI_BASE="amazonlinux:2023"
# aws-nitro-enclaves-cli-devel ships the enclave blobs (kernel/init/cmdline/nsm)
# under /usr/share/nitro_enclaves/blobs/ that build-enclave bakes into the EIF -
# the base cli package alone does NOT include them, so it is required here.
NITRO_CLI_PACKAGES="aws-nitro-enclaves-cli aws-nitro-enclaves-cli-devel"

# BuildKit/buildx: the `rewrite-timestamp` exporter option needs BuildKit
# >= v0.13. build-eif.sh and CI pin the builder to this image.
BUILDKIT_VERSION="v0.13.2"
